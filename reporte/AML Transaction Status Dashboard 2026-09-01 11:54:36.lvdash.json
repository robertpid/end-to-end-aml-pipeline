{
  "datasets": [
    {
      "name": "aml_alerts",
      "displayName": "AML Alerts Data",
      "queryLines": [
        "-- AML alerts data with all rule categories\n",
        "SELECT\n",
        "  Fecha_Transaccion AS Fecha,\n",
        "  CASE\n",
        "    WHEN Monto_USD > 9500 THEN 'KYC Deviation'\n",
        "    WHEN Monto_USD > 9000 THEN 'Structuring (Pitufeo)'\n",
        "    WHEN Monto_USD > 8000 THEN 'Crypto Mixer'\n",
        "    WHEN Monto_USD > 6000 THEN 'Fan-In Platform'\n",
        "    ELSE 'Other Rule'\n",
        "  END AS Rule_Triggered,\n",
        "  Monto_USD,\n",
        "  PK_Transaccion AS Alert_ID,\n",
        "  FK_Cliente_Origen AS Cliente_ID,\n",
        "  CASE\n",
        "    WHEN Monto_USD > 9000 THEN 'ALTO RIESGO - ALERTA ROJA'\n",
        "    ELSE 'MEDIO RIESGO - MONITOREO'\n",
        "  END AS Nivel_Riesgo\n",
        "FROM\n",
        "  workspace.aml_proyect.transacciones_plata_robert\n",
        "WHERE\n",
        "  Fecha_Transaccion >= DATE('2026-08-01')\n",
        "  AND Monto_USD > 5000\n",
        "ORDER BY\n",
        "  Fecha_Transaccion DESC"
      ]
    }
  ],
